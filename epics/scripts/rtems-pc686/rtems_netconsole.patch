@@ -0,0 +1,26 @@
+/*************************************************************************\
+* SPDX-License-Identifier: EPICS
+* EPICS BASE is distributed subject to a Software License Agreement found
+* in file LICENSE that is included with this distribution.
+\*************************************************************************/
+/*
+ * procServ-like network console for RTEMS-pc686, see netconsole.c
+ */
+#ifndef INC_netconsole_H
+#define INC_netconsole_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* redirect stdin/stdout/stderr and printk through /dev/netcons */
+int netconsoleInit(void);
+
+/* start the TCP server, call once the network is up */
+int netconsoleStart(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* INC_netconsole_H */
