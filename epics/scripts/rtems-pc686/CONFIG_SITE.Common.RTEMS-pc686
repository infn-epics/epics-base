# Site overrides for RTEMS-pc686, installed as
# configure/os/CONFIG_SITE.Common.RTEMS-pc686 (read after
# os/CONFIG.Common.RTEMS-pc686, so this override wins)

# The pc386 multiboot header has no a.out kludge (flags 0), so iPXE, GRUB and
# qemu -kernel can only load an ELF image. Make <ioc>.boot a stripped ELF
# instead of the default raw binary, keeping the rtems-proxy convention that
# <ioc>.boot is the bootable image.
define MUNCH_CMD
	$(RTEMS_TOOLS)/bin/$(OBJCOPY_FOR_TARGET) -R .comment -S $< $@
endef

# Limit RTEMS to the first 480 MB of RAM, as Linux does on the VMIVME-7750
# (mem=480M): the top of the 512 MB is not used. Booting with the full RAM
# reset the board at startup during bring-up; not yet confirmed which of
# the fixes made at the same time solved it, so keep the tested setting.
OP_SYS_LDFLAGS += -Wl,--defsym=RamSize=0x1E000000
