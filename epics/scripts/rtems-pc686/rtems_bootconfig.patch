 }
 
-#elif defined(__mcf528x__)
+#elif defined(__mcf528x__) || defined(__i386__)
+
+#if defined(__i386__)
+#include <rtems/bspcmdline.h>
+/*
+ * pc686 (x86 VME boards e.g. VMIVME-7750): there is no NVRAM, the boot
+ * environment is the multiboot command line written by the PXE boot loader:
+ *   IPADDR0=192.168.192.68 NETMASK=255.255.255.0 GATEWAY=192.168.192.1
+ *   SERVER=192.168.192.248 NFSMOUNT=192.168.192.248:/export/ioc:/epics
+ *   CMDLINE=/epics/st.cmd HOSTNAME=myioc
+ * Keys must match whole words: SERVER must not match NTPSERVER=...
+ */
+static const char *
+bsp_getbenv(const char *parm)
+{
+    static char value[256];
+    const char *cp = rtems_bsp_cmdline_get();
+    size_t l = strlen(parm);
+
+    while (cp && *cp) {
+        while (*cp == ' ')
+            cp++;
+        if (strncmp(cp, parm, l) == 0 && cp[l] == '=') {
+            const char *v = cp + l + 1;
+            size_t n = strcspn(v, " ");
+
+            if (n >= sizeof(value))
+                n = sizeof(value) - 1;
+            memcpy(value, v, n);
+            value[n] = '\0';
+            return value;
+        }
+        cp = strchr(cp, ' ');
+    }
+    return NULL;
+}
+#endif
 
