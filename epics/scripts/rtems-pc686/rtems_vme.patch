diff --git a/modules/libcom/RTEMS/vmeShell.c b/modules/libcom/RTEMS/vmeShell.c
new file mode 100644
index 0000000..d2cc261
--- /dev/null
+++ b/modules/libcom/RTEMS/vmeShell.c
@@ -0,0 +1,233 @@
+/*************************************************************************\
+* SPDX-License-Identifier: EPICS
+* EPICS BASE is distributed subject to a Software License Agreement found
+* in file LICENSE that is included with this distribution.
+\*************************************************************************/
+/*
+ * iocsh commands for the VME bus of RTEMS-pc686 boards (Universe II, e.g.
+ * VMIVME-7750):
+ *
+ *   vmeShow                                      outbound/inbound windows
+ *   vmeMasterWindow port am vmeAddr pciAddr size outbound window (st.cmd)
+ *   vmeProbe A16|A24|A32|CSR|<AM> addr [1|2|4]        bus error safe read
+ *   vmeWrite A16|A24|A32|CSR|<AM> addr value [1|2|4]  bus error safe write
+ *   vmeDiag A16|A24|A32|CSR addr [1|2|4]         plain read, bridge registers
+ *                                                before and after (debug)
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <bsp/VME.h>
+#include <bsp/VMEConfig.h>
+
+#include "devLibVME.h"
+#include "iocsh.h"
+#include "epicsTypes.h"
+
+#include "vmeShell.h"
+
+static int addrType(const char *name, epicsAddressType *type)
+{
+    if (name == NULL) {
+        printf("address type missing: A16, A24, A32 or CSR\n");
+        return -1;
+    }
+    if (strcmp(name, "A16") == 0 || strcmp(name, "a16") == 0)
+        *type = atVMEA16;
+    else if (strcmp(name, "A24") == 0 || strcmp(name, "a24") == 0)
+        *type = atVMEA24;
+    else if (strcmp(name, "A32") == 0 || strcmp(name, "a32") == 0)
+        *type = atVMEA32;
+    else if (strcmp(name, "CSR") == 0 || strcmp(name, "csr") == 0)
+        *type = atVMECSR;
+    else {
+        printf("bad address type '%s': A16, A24, A32 or CSR\n", name);
+        return -1;
+    }
+    return 0;
+}
+
+/*
+ * Map a VME address to a local address. 'space' is A16, A24, A32, CSR (the
+ * supervisory data AMs used by devLib) or an address modifier number, e.g.
+ * 0x09 for A32 user data; a window with that AM must exist (vmeMasterWindow).
+ */
+static int vmeToLocal(const char *space, epicsUInt32 addr, volatile void **local)
+{
+    epicsAddressType type;
+    char *end;
+    unsigned long am;
+    unsigned long l;
+
+    if (space == NULL) {
+        printf("address space missing: A16, A24, A32, CSR or an AM number\n");
+        return -1;
+    }
+    am = strtoul(space, &end, 0);
+    if (end != space && *end == '\0') {
+        if (BSP_vme2local_adrs(am, addr, &l) != 0) {
+            printf("AM 0x%02lx 0x%08x: not mapped by any VME window\n", am,
+                   (unsigned) addr);
+            return -1;
+        }
+        *local = (volatile void *) l;
+        return 0;
+    }
+    if (addrType(space, &type) != 0)
+        return -1;
+    if (devBusToLocalAddr(type, addr, local) != 0) {
+        printf("%s 0x%08x: not mapped by any VME window\n", space,
+               (unsigned) addr);
+        return -1;
+    }
+    return 0;
+}
+
+static int width(int w)
+{
+    if (w == 0)
+        return 2;
+    if (w == 1 || w == 2 || w == 4)
+        return w;
+    printf("bad width %d: 1, 2 or 4 bytes\n", w);
+    return -1;
+}
+
+/* vmeShow */
+static const iocshFuncDef vmeShowFuncDef = {"vmeShow", 0, NULL,
+    "Show the VME outbound and inbound windows\n"};
+static void vmeShowCallFunc(const iocshArgBuf *args)
+{
+    (void) args;
+    BSP_VMEOutboundPortsShow(stdout);
+    BSP_VMEInboundPortsShow(stdout);
+}
+
+/* vmeMasterWindow port am vmeAddr pciAddr size */
+static const iocshArg vmeMasterWindowArg0 = {"port (3..6 are free)", iocshArgInt};
+static const iocshArg vmeMasterWindowArg1 = {"address modifier", iocshArgInt};
+static const iocshArg vmeMasterWindowArg2 = {"VME address", iocshArgInt};
+static const iocshArg vmeMasterWindowArg3 = {"PCI address", iocshArgInt};
+static const iocshArg vmeMasterWindowArg4 = {"size (0 disables)", iocshArgInt};
+static const iocshArg * const vmeMasterWindowArgs[5] = {
+    &vmeMasterWindowArg0, &vmeMasterWindowArg1, &vmeMasterWindowArg2,
+    &vmeMasterWindowArg3, &vmeMasterWindowArg4};
+static const iocshFuncDef vmeMasterWindowFuncDef = {"vmeMasterWindow", 5,
+    vmeMasterWindowArgs,
+    "Configure a VME outbound (master) window, e.g. A32 0x0d:\n"
+    "  vmeMasterWindow 3 0x0d 0xee000000 0xa0000000 0x01000000\n"
+    "Use PCI addresses 0x80000000..0xefffffff not used by the default\n"
+    "windows (0x90000000..0x9fffffff).\n"};
+static void vmeMasterWindowCallFunc(const iocshArgBuf *args)
+{
+    int status = BSP_VMEOutboundPortCfg(
+        (unsigned long) args[0].ival, (unsigned long) args[1].ival,
+        (unsigned long) (epicsUInt32) args[2].ival,
+        (unsigned long) (epicsUInt32) args[3].ival,
+        (unsigned long) (epicsUInt32) args[4].ival);
+
+    if (status)
+        printf("vmeMasterWindow: failed (%d)\n", status);
+    iocshSetError(status);
+}
+
+/* vmeProbe type addr width */
+static const iocshArg vmeProbeArg0 = {"A16|A24|A32|CSR or AM number", iocshArgString};
+static const iocshArg vmeProbeArg1 = {"VME address", iocshArgInt};
+static const iocshArg vmeProbeArg2 = {"width 1|2|4 (default 2)", iocshArgInt};
+static const iocshArg * const vmeProbeArgs[3] = {
+    &vmeProbeArg0, &vmeProbeArg1, &vmeProbeArg2};
+static const iocshFuncDef vmeProbeFuncDef = {"vmeProbe", 3, vmeProbeArgs,
+    "Read a VME location, reporting bus errors\n"};
+static void vmeProbeCallFunc(const iocshArgBuf *args)
+{
+    volatile void *local;
+    epicsUInt32 value = 0;
+    epicsUInt32 addr = (epicsUInt32) args[1].ival;
+    int w = width(args[2].ival);
+
+    if (w < 0 || vmeToLocal(args[0].sval, addr, &local) != 0) {
+        iocshSetError(-1);
+        return;
+    }
+    if (devReadProbe(w, local, &value)) {
+        printf("%s 0x%08x (local %p): bus error\n", args[0].sval,
+               (unsigned) addr, (void *) local);
+        iocshSetError(-1);
+        return;
+    }
+    if (w == 1)
+        printf("%s 0x%08x: 0x%02x\n", args[0].sval, (unsigned) addr,
+               (unsigned) (value & 0xff));
+    else if (w == 2)
+        printf("%s 0x%08x: 0x%04x\n", args[0].sval, (unsigned) addr,
+               (unsigned) (value & 0xffff));
+    else
+        printf("%s 0x%08x: 0x%08x\n", args[0].sval, (unsigned) addr,
+               (unsigned) value);
+}
+
+/* vmeWrite type addr value width */
+static const iocshArg vmeWriteArg0 = {"A16|A24|A32|CSR or AM number", iocshArgString};
+static const iocshArg vmeWriteArg1 = {"VME address", iocshArgInt};
+static const iocshArg vmeWriteArg2 = {"value", iocshArgInt};
+static const iocshArg vmeWriteArg3 = {"width 1|2|4 (default 2)", iocshArgInt};
+static const iocshArg * const vmeWriteArgs[4] = {
+    &vmeWriteArg0, &vmeWriteArg1, &vmeWriteArg2, &vmeWriteArg3};
+static const iocshFuncDef vmeWriteFuncDef = {"vmeWrite", 4, vmeWriteArgs,
+    "Write a VME location, reporting bus errors\n"};
+static void vmeWriteCallFunc(const iocshArgBuf *args)
+{
+    volatile void *local;
+    epicsUInt32 addr = (epicsUInt32) args[1].ival;
+    epicsUInt32 value = (epicsUInt32) args[2].ival;
+    int w = width(args[3].ival);
+
+    if (w < 0 || vmeToLocal(args[0].sval, addr, &local) != 0) {
+        iocshSetError(-1);
+        return;
+    }
+    if (devWriteProbe(w, local, &value)) {
+        printf("%s 0x%08x: bus error\n", args[0].sval, (unsigned) addr);
+        iocshSetError(-1);
+    }
+}
+
+/* vmeDiag type addr width */
+static const iocshFuncDef vmeDiagFuncDef = {"vmeDiag", 3, vmeProbeArgs,
+    "Plain (not bus error safe) read, showing the Universe and VMIC error\n"
+    "registers before and after it\n"};
+static void vmeDiagCallFunc(const iocshArgBuf *args)
+{
+    volatile void *local;
+    epicsUInt32 value = 0;
+    epicsUInt32 addr = (epicsUInt32) args[1].ival;
+    int w = width(args[2].ival);
+
+    if (w < 0 || vmeToLocal(args[0].sval, addr, &local) != 0)
+        return;
+    _BSP_clear_hostbridge_errors(0, 1);
+    printf("--- before (errors cleared)\n");
+    BSP_VMEErrorsShow();
+    if (w == 1)
+        value = *(volatile epicsUInt8 *) local;
+    else if (w == 2)
+        value = *(volatile epicsUInt16 *) local;
+    else
+        value = *(volatile epicsUInt32 *) local;
+    printf("--- after reading %s 0x%08x (local %p): 0x%x\n", args[0].sval,
+           (unsigned) addr, (void *) local, (unsigned) value);
+    BSP_VMEErrorsShow();
+    _BSP_clear_hostbridge_errors(0, 0);
+}
+
+void vmeShellRegister(void)
+{
+    iocshRegister(&vmeDiagFuncDef, vmeDiagCallFunc);
+    iocshRegister(&vmeShowFuncDef, vmeShowCallFunc);
+    iocshRegister(&vmeMasterWindowFuncDef, vmeMasterWindowCallFunc);
+    iocshRegister(&vmeProbeFuncDef, vmeProbeCallFunc);
+    iocshRegister(&vmeWriteFuncDef, vmeWriteCallFunc);
+}
