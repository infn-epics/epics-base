diff --git a/modules/libcom/RTEMS/netconsole.c b/modules/libcom/RTEMS/netconsole.c
new file mode 100644
index 0000000..385288c
--- /dev/null
+++ b/modules/libcom/RTEMS/netconsole.c
@@ -0,0 +1,423 @@
+/*************************************************************************\
+* SPDX-License-Identifier: EPICS
+* EPICS BASE is distributed subject to a Software License Agreement found
+* in file LICENSE that is included with this distribution.
+\*************************************************************************/
+/*
+ * procServ-like network console for RTEMS-pc686 (x86 VME boards without a
+ * serial line, e.g. the VMIVME-7750).
+ *
+ * netconsoleInit() is called at the start of POSIX_Init: stdin/stdout/stderr
+ * are reopened on /dev/netcons, and printk is hooked. Everything written to
+ * the console still goes to the real console (VGA or COM1) and is also kept
+ * in a ring buffer, so the boot log is available later.
+ *
+ * netconsoleStart() is called when the network is up: a TCP server (port 23,
+ * or CONSOLEPORT=<n> on the boot command line) sends each client the ring
+ * buffer history and then the live output. Input from the clients and from
+ * the real console is merged and read by the IOC shell, as with procServ.
+ */
+
+#include <rtems.h>
+#include <rtems/imfs.h>
+#include <rtems/libio.h>
+#include <rtems/bspIo.h>
+#include <rtems/bspcmdline.h>
+
+#include <sys/types.h>
+#include <sys/socket.h>
+#include <sys/select.h>
+#include <sys/ioctl.h>
+#include <sys/time.h>
+#include <netinet/in.h>
+
+#include <pthread.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+
+#include "netconsole.h"
+
+#define NC_RING_SIZE    (64 * 1024)     /* console history, power of two */
+#define NC_IN_SIZE      1024            /* merged input queue */
+#define NC_MAX_CLIENTS  4
+#define NC_DEFAULT_PORT 23
+#define NC_SEND_CHUNK   1024
+
+/* console history: nc_total counts all bytes ever written (wraps, unsigned) */
+static char nc_ring[NC_RING_SIZE];
+static volatile uint32_t nc_total;
+
+/* the real console, saved before stdin/stdout/stderr are redirected */
+static int nc_cons_out = -1;
+static int nc_cons_in = -1;
+static BSP_output_char_function_type nc_printk_orig;
+
+/* merged input from the real console and the network clients */
+static pthread_mutex_t nc_in_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t nc_in_cond = PTHREAD_COND_INITIALIZER;
+static char nc_in[NC_IN_SIZE];
+static unsigned nc_in_head;
+static unsigned nc_in_count;
+
+/*
+ * Append to the history. Called from tasks and, through printk, possibly
+ * from interrupt handlers: copy with interrupts disabled, in small chunks
+ * (pc686 is uniprocessor).
+ */
+static void nc_ring_put(const char *buf, size_t len)
+{
+    while (len > 0) {
+        size_t chunk = len > 128 ? 128 : len;
+        rtems_interrupt_level level;
+        size_t i;
+
+        rtems_interrupt_local_disable(level);
+        for (i = 0; i < chunk; i++)
+            nc_ring[(nc_total + i) & (NC_RING_SIZE - 1)] = buf[i];
+        nc_total += chunk;
+        rtems_interrupt_local_enable(level);
+        buf += chunk;
+        len -= chunk;
+    }
+}
+
+static void nc_printk(char c)
+{
+    nc_printk_orig(c);
+    nc_ring_put(&c, 1);
+}
+
+static void nc_input_put(const char *buf, size_t len)
+{
+    size_t i;
+
+    pthread_mutex_lock(&nc_in_lock);
+    for (i = 0; i < len && nc_in_count < NC_IN_SIZE; i++) {
+        nc_in[(nc_in_head + nc_in_count) % NC_IN_SIZE] = buf[i];
+        nc_in_count++;
+    }
+    pthread_cond_broadcast(&nc_in_cond);
+    pthread_mutex_unlock(&nc_in_lock);
+}
+
+/* /dev/netcons handlers */
+
+static ssize_t nc_read(rtems_libio_t *iop, void *buffer, size_t count)
+{
+    char *b = buffer;
+    size_t n = 0;
+
+    (void) iop;
+    if (count == 0)
+        return 0;
+    pthread_mutex_lock(&nc_in_lock);
+    while (nc_in_count == 0)
+        pthread_cond_wait(&nc_in_cond, &nc_in_lock);
+    while (n < count && nc_in_count > 0) {
+        char c = nc_in[nc_in_head];
+
+        nc_in_head = (nc_in_head + 1) % NC_IN_SIZE;
+        nc_in_count--;
+        b[n++] = c;
+        if (c == '\n')
+            break;
+    }
+    pthread_mutex_unlock(&nc_in_lock);
+    return n;
+}
+
+static ssize_t nc_write(rtems_libio_t *iop, const void *buffer, size_t count)
+{
+    (void) iop;
+    if (nc_cons_out >= 0)
+        write(nc_cons_out, buffer, count);
+    nc_ring_put(buffer, count);
+    return count;
+}
+
+/* termios requests (isatty, tcgetattr...) go to the real console */
+static int nc_ioctl(rtems_libio_t *iop, ioctl_command_t request, void *buffer)
+{
+    (void) iop;
+    if (nc_cons_out < 0) {
+        errno = ENOTTY;
+        return -1;
+    }
+    return ioctl(nc_cons_out, request, buffer);
+}
+
+static const rtems_filesystem_file_handlers_r nc_handlers = {
+    .open_h = rtems_filesystem_default_open,
+    .close_h = rtems_filesystem_default_close,
+    .read_h = nc_read,
+    .write_h = nc_write,
+    .ioctl_h = nc_ioctl,
+    .lseek_h = rtems_filesystem_default_lseek,
+    .fstat_h = IMFS_stat,
+    .ftruncate_h = rtems_filesystem_default_ftruncate,
+    .fsync_h = rtems_filesystem_default_fsync_or_fdatasync_success,
+    .fdatasync_h = rtems_filesystem_default_fsync_or_fdatasync_success,
+    .fcntl_h = rtems_filesystem_default_fcntl,
+    .poll_h = rtems_filesystem_default_poll,
+    .kqfilter_h = rtems_filesystem_default_kqfilter,
+    .readv_h = rtems_filesystem_default_readv,
+    .writev_h = rtems_filesystem_default_writev,
+    .mmap_h = rtems_filesystem_default_mmap
+};
+
+static const IMFS_node_control nc_node_control = IMFS_GENERIC_INITIALIZER(
+    &nc_handlers, IMFS_node_initialize_generic, IMFS_node_destroy_default);
+
+/* the real console keeps working as an input source */
+static void *nc_console_reader(void *arg)
+{
+    char buf[128];
+    ssize_t n;
+
+    (void) arg;
+    while ((n = read(nc_cons_in, buf, sizeof(buf))) > 0)
+        nc_input_put(buf, n);
+    return NULL;
+}
+
+int netconsoleInit(void)
+{
+    pthread_t tid;
+    int fd;
+
+    fflush(stdout);
+    fflush(stderr);
+    if (IMFS_make_generic_node("/dev/netcons", S_IFCHR | 0666,
+                               &nc_node_control, NULL) != 0)
+        return -1;
+    nc_cons_out = dup(1);
+    nc_cons_in = dup(0);
+    if (nc_cons_out < 0 || nc_cons_in < 0)
+        return -1;
+    fd = open("/dev/netcons", O_RDWR);
+    if (fd < 0)
+        return -1;
+    dup2(fd, 0);
+    dup2(fd, 1);
+    dup2(fd, 2);
+    if (fd > 2)
+        close(fd);
+
+    nc_printk_orig = BSP_output_char;
+    BSP_output_char = nc_printk;
+
+    if (pthread_create(&tid, NULL, nc_console_reader, NULL) == 0)
+        pthread_detach(tid);
+    return 0;
+}
+
+/* TCP server */
+
+struct nc_client {
+    int fd;
+    uint32_t pos;       /* next history byte to send */
+    int iac;            /* telnet command parser state */
+    int cr;             /* last input byte was CR */
+};
+
+/* strip telnet commands, map CR, CR LF and CR NUL to LF */
+static void nc_client_input(struct nc_client *c, const unsigned char *buf, size_t len)
+{
+    char out[256];
+    size_t i, n = 0;
+
+    for (i = 0; i < len && n < sizeof(out); i++) {
+        unsigned char b = buf[i];
+
+        switch (c->iac) {
+        case 1:                             /* after IAC */
+            if (b >= 251 && b <= 254)
+                c->iac = 2;                 /* WILL/WONT/DO/DONT option */
+            else if (b == 250)
+                c->iac = 3;                 /* SB ... IAC SE */
+            else
+                c->iac = 0;
+            continue;
+        case 2:
+            c->iac = 0;
+            continue;
+        case 3:
+            if (b == 255)
+                c->iac = 4;
+            continue;
+        case 4:
+            c->iac = (b == 240) ? 0 : 3;
+            continue;
+        }
+        if (b == 255) {
+            c->iac = 1;
+            continue;
+        }
+        if (c->cr && (b == '\n' || b == '\0')) {
+            c->cr = 0;
+            continue;
+        }
+        c->cr = (b == '\r');
+        out[n++] = (b == '\r') ? '\n' : b;
+    }
+    if (n > 0)
+        nc_input_put(out, n);
+}
+
+/* send new history to a client, LF -> CR LF; returns -1 to drop it */
+static int nc_client_output(struct nc_client *c)
+{
+    char out[2 * NC_SEND_CHUNK];
+    uint32_t total = nc_total;
+    size_t n = 0, used = 0;
+
+    if (total - c->pos > NC_RING_SIZE)
+        c->pos = total - NC_RING_SIZE;          /* client fell behind */
+    while (c->pos + used != total && used < NC_SEND_CHUNK) {
+        char ch = nc_ring[(c->pos + used) & (NC_RING_SIZE - 1)];
+
+        if (ch == '\n')
+            out[n++] = '\r';
+        out[n++] = ch;
+        used++;
+    }
+    if (n > 0 && send(c->fd, out, n, 0) != (ssize_t) n)
+        return -1;
+    c->pos += used;
+    return 0;
+}
+
+static int nc_port(void)
+{
+    const char *cp = rtems_bsp_cmdline_get();
+    const char *key = "CONSOLEPORT=";
+    size_t l = strlen(key);
+
+    while (cp && *cp) {
+        while (*cp == ' ')
+            cp++;
+        if (strncmp(cp, key, l) == 0)
+            return atoi(cp + l);
+        cp = strchr(cp, ' ');
+    }
+    return NC_DEFAULT_PORT;
+}
+
+static void *nc_server(void *arg)
+{
+    struct nc_client cl[NC_MAX_CLIENTS];
+    struct sockaddr_in addr;
+    struct timeval sndtmo = { 2, 0 };
+    int port = (int)(intptr_t) arg;
+    int ls, one = 1, i;
+
+    for (i = 0; i < NC_MAX_CLIENTS; i++)
+        cl[i].fd = -1;
+
+    ls = socket(AF_INET, SOCK_STREAM, 0);
+    if (ls < 0) {
+        printf("netconsole: socket failed: %s\n", strerror(errno));
+        return NULL;
+    }
+    setsockopt(ls, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
+    memset(&addr, 0, sizeof(addr));
+    addr.sin_family = AF_INET;
+    addr.sin_port = htons(port);
+    addr.sin_addr.s_addr = htonl(INADDR_ANY);
+    if (bind(ls, (struct sockaddr *) &addr, sizeof(addr)) < 0 ||
+        listen(ls, 2) < 0) {
+        printf("netconsole: bind/listen on port %d failed: %s\n",
+               port, strerror(errno));
+        close(ls);
+        return NULL;
+    }
+
+    for (;;) {
+        struct timeval tmo = { 0, 50000 };
+        fd_set rfds;
+        int maxfd = ls;
+
+        FD_ZERO(&rfds);
+        FD_SET(ls, &rfds);
+        for (i = 0; i < NC_MAX_CLIENTS; i++) {
+            if (cl[i].fd >= 0) {
+                FD_SET(cl[i].fd, &rfds);
+                if (cl[i].fd > maxfd)
+                    maxfd = cl[i].fd;
+            }
+        }
+
+        if (select(maxfd + 1, &rfds, NULL, NULL, &tmo) > 0) {
+            if (FD_ISSET(ls, &rfds)) {
+                int fd = accept(ls, NULL, NULL);
+
+                if (fd >= 0) {
+                    for (i = 0; i < NC_MAX_CLIENTS && cl[i].fd >= 0; i++)
+                        ;
+                    if (i == NC_MAX_CLIENTS) {
+                        static const char busy[] =
+                            "netconsole: too many clients\r\n";
+                        send(fd, busy, sizeof(busy) - 1, 0);
+                        close(fd);
+                    } else {
+                        static const char hello[] =
+                            "\r\n*** RTEMS netconsole: history follows ***\r\n";
+                        uint32_t total = nc_total;
+
+                        setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO,
+                                   &sndtmo, sizeof(sndtmo));
+                        cl[i].fd = fd;
+                        cl[i].iac = cl[i].cr = 0;
+                        cl[i].pos = total > NC_RING_SIZE ?
+                                    total - NC_RING_SIZE : 0;
+                        send(fd, hello, sizeof(hello) - 1, 0);
+                    }
+                }
+            }
+            for (i = 0; i < NC_MAX_CLIENTS; i++) {
+                if (cl[i].fd >= 0 && FD_ISSET(cl[i].fd, &rfds)) {
+                    unsigned char buf[256];
+                    ssize_t n = recv(cl[i].fd, buf, sizeof(buf), 0);
+
+                    if (n <= 0) {
+                        close(cl[i].fd);
+                        cl[i].fd = -1;
+                    } else {
+                        nc_client_input(&cl[i], buf, n);
+                    }
+                }
+            }
+        }
+
+        for (i = 0; i < NC_MAX_CLIENTS; i++) {
+            if (cl[i].fd >= 0 && nc_client_output(&cl[i]) < 0) {
+                close(cl[i].fd);
+                cl[i].fd = -1;
+            }
+        }
+    }
+    return NULL;
+}
+
+int netconsoleStart(void)
+{
+    int port = nc_port();
+    pthread_t tid;
+
+    if (nc_cons_out < 0) {
+        printf("netconsole: not initialized\n");
+        return -1;
+    }
+    if (pthread_create(&tid, NULL, nc_server, (void *)(intptr_t) port) != 0) {
+        printf("netconsole: can't start server\n");
+        return -1;
+    }
+    pthread_detach(tid);
+    printf("***** netconsole on TCP port %d *****\n", port);
+    return 0;
+}
